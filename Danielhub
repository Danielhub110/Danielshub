-- FIXED MM2 Delta Hub (Player ESP, Gun ESP, Auto-Grab, Floating Return-TP, and Inf Jump)
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

_G.MM2_ESP_Enabled = false
_G.AutoGrabGun = false
_G.GunESP_Enabled = true 
_G.InfJump_Enabled = false

local function locateGunDrop()
    local gun = Workspace:FindFirstChild("GunDrop")
    if gun then return gun end
    
    for _, v in ipairs(Workspace:GetChildren()) do
        if v:IsA("Folder") or v:IsA("Model") then
            local mapGun = v:FindFirstChild("GunDrop", true)
            if mapGun then return mapGun end
        end
    end
    return nil
end

local function applyESP(player)
    if player == LocalPlayer then return end
    local function setupHighlight(char)
        task.wait(1)
        if char:FindFirstChild("RoleESP") then char.RoleESP:Destroy() end
        local highlight = Instance.new("Highlight")
        highlight.Name = "RoleESP"
        highlight.Parent = char
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.Enabled = _G.MM2_ESP_Enabled
        highlight.FillColor = Color3.fromRGB(0, 255, 0)
        task.spawn(function()
            while char and char:IsDescendantOf(Workspace) do
                if not highlight or not highlight.Parent then break end
                highlight.Enabled = _G.MM2_ESP_Enabled
                if _G.MM2_ESP_Enabled then
                    local backpack = player:FindFirstChild("Backpack")
                    local hasKnife = (backpack and backpack:FindFirstChild("Knife")) or char:FindFirstChild("Knife")
                    local hasGun = (backpack and backpack:FindFirstChild("Gun")) or char:FindFirstChild("Gun")
                    if hasKnife then
                        highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    elseif hasGun then
                        highlight.FillColor = Color3.fromRGB(0, 0, 255)
                    else
                        highlight.FillColor = Color3.fromRGB(0, 255, 0)
                    end
                end
                task.wait(1)
            end
        end)
    end
    if player.Character then task.spawn(setupHighlight, player.Character) end
    player.CharacterAdded:Connect(setupHighlight)
end

for _, player in ipairs(Players:GetPlayers()) do applyESP(player) end
Players.PlayerAdded:Connect(applyESP)

local function updateAllESPHighlights()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("RoleESP") then
            p.Character.RoleESP.Enabled = _G.MM2_ESP_Enabled
        end
    end
end

local function teleportToGun()
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local gunDrop = locateGunDrop()
        if gunDrop then
            local originalCFrame = character:GetPivot()
            character:PivotTo(gunDrop:GetPivot() * CFrame.new(0, 1.5, 0))
            print("[Delta MM2] Teleported to Gun!")
            task.wait(0.25)
            character:PivotTo(originalCFrame)
            print("[Delta MM2] Safely returned to original position!")
        else
            print("[Delta MM2] Gun drop object not actively found on the map yet.")
        end
    end
end

task.spawn(function()
    while true do
        local gunDrop = locateGunDrop()
        if gunDrop then
            if _G.GunESP_Enabled then
                if not gunDrop:FindFirstChild("GunHighlight") then
                    local gunHighlight = Instance.new("Highlight")
                    gunHighlight.Name = "GunHighlight"
                    gunHighlight.Parent = gunDrop
                    gunHighlight.FillColor = Color3.fromRGB(255, 255, 0)
                    gunHighlight.FillTransparency = 0.2
                    gunHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                end
            else
                if gunDrop:FindFirstChild("GunHighlight") then
                    gunDrop.GunHighlight:Destroy()
                end
            end
            if _G.AutoGrabGun then
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local originalCFrame = character:GetPivot()
                    character:PivotTo(gunDrop:GetPivot() * CFrame.new(0, 1.5, 0))
                    task.wait(0.25)
                    character:PivotTo(originalCFrame)
                end
            end
        end
        task.wait(0.3)
    end
end)

UserInputService.JumpRequest:Connect(function()
    if _G.InfJump_Enabled then
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

